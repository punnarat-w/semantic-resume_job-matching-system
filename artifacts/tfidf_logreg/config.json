{
  "seed": 42,
  "vectorizer": {
    "max_features": 50000,
    "ngram_range": [
      1,
      2
    ],
    "lowercase": true,
    "strip_accents": "unicode",
    "min_df": 2,
    "max_df": 0.95,
    "sublinear_tf": true
  },
  "classifier": {
    "class_weight": "balanced",
    "max_iter": 1000,
    "solver": "liblinear",
    "random_state": 42
  },
  "training": {
    "validation_split": 0.2,
    "threshold": 0.5
  }
}